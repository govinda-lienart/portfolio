---
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** cap display width in px */
  width?: number;
  /** cap the whole figure (image + caption) to this width in px and centre it */
  maxWidth?: number;
}
const { src, alt, caption, width = 900, maxWidth } = Astro.props;
---

<figure class="am-figure" style={maxWidth ? `max-width:${maxWidth}px;margin-inline:auto` : undefined}>
  <Image src={src} alt={alt} width={width} data-full={src.src} />
  {caption && (
    <figcaption>
      <span class="am-figure__label">Fig</span>
      {caption}
    </figcaption>
  )}
</figure>

<style>
  .am-figure {
    margin: 2em 0;
    counter-increment: am-figure;
  }
  .am-figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-hairline);
  }
  .am-figure figcaption {
    margin-top: 0.7rem;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--sl-color-text);
  }
  .am-figure__label {
    font-family: 'Merriweather Sans', sans-serif;
    font-weight: 800;
  }
  .am-figure__label::after {
    content: ' ' counter(am-figure) '. ';
    font-weight: 800;
  }
</style>
