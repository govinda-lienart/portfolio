---
interface Props {
  src: string;
  alt: string;
  caption?: string;
}
const { src, alt, caption } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = src.startsWith('http') || src.startsWith(base) ? src : `${base}${src}`;
---

<figure class="am-figure">
  <img src={href} alt={alt} />
  {caption && (
    <figcaption>
      <span class="am-figure__label">Fig</span>
      {caption}
    </figcaption>
  )}
</figure>

<style>
  .am-figure { margin: 2em 0; counter-increment: am-figure; }
  .am-figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-hairline);
    background: #fff;
  }
  .am-figure figcaption {
    margin-top: 0.7rem;
    font-size: 0.82rem;
    line-height: 1.6;
  }
  .am-figure__label { font-family: 'Merriweather Sans', sans-serif; font-weight: 800; }
  .am-figure__label::after { content: ' ' counter(am-figure) '. '; }
</style>
