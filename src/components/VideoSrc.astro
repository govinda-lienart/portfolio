---
interface Props {
  src: string;
  poster?: string;
  caption?: string;
}
const { src, poster, caption } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = src.startsWith('http') || src.startsWith(base) ? src : `${base}${src}`;
const posterHref = poster && (poster.startsWith('http') || poster.startsWith(base) ? poster : `${base}${poster}`);
---

<figure class="am-video">
  <video controls muted loop playsinline poster={posterHref} preload="none">
    <source src={href} type="video/mp4" />
  </video>
  {caption && (
    <figcaption>
      <span class="am-video__label">Vid</span>
      {caption}
    </figcaption>
  )}
</figure>

<style>
  .am-video { margin: 2em 0; counter-increment: am-video; }
  .am-video video {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-hairline);
    background: #fff;
  }
  .am-video figcaption {
    margin-top: 0.7rem;
    font-size: 0.82rem;
    line-height: 1.6;
  }
  .am-video__label { font-family: 'Merriweather Sans', sans-serif; font-weight: 800; }
  .am-video__label::after { content: ' ' counter(am-video) '. '; }
</style>
