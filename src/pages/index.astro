---
import { Image } from 'astro:assets';
import heroBg from '../assets/hero/hero-bg.jpg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>Govinda Lienart — Portfolio</title>
    <meta
      name="description"
      content="Portfolio of Govinda Lienart — behavioural ecologist turned machine-learning engineer. Computer vision, PyTorch, MLOps."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;1,9..144,400&family=Spectral:ital,wght@0,300;0,400;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header>
      <a class="wordmark" href={`${base}/`}>
        Govinda&nbsp;Lienart
        <small>Machine-learning engineer</small>
      </a>
      <nav class="hnav">
        <a href={`${base}/about/`}>About me</a>
        <a href={`${base}/contact/`}>Contact me</a>
      </nav>
    </header>

    <main class="opening">
      <div class="hero-stage">
        <Image src={heroBg} alt="" class="hero-img" widths={[900, 1600, 2148]} loading="eager" />
      </div>
      <div class="opening-veil"></div>

      <div class="opening-inner">
        <p class="eyebrow">Portfolio · {year}</p>
        <h1>Behaviour, <em>measured</em> by machine.</h1>

        <ul class="projects">
          <li class="project">
            <h2>AquaMind</h2>
            <p class="project-blurb">
              Detecting, tracking and re-identifying individual zebrafish through
              occlusion — then classifying real behaviour for a chemical-alarm-cue
              antipredator assay.
            </p>
            <a class="enter" href={`${base}/aquamind/`}>Enter the project</a>
          </li>
        </ul>
      </div>
    </main>

    <footer>
      <span>© {year} Govinda Lienart</span>
      <span><a href="https://github.com/govinda-lienart">github.com/govinda-lienart</a></span>
    </footer>

    <style>
      :root {
        --ground: #0b0d0c;
        --ground-2: #12140f;
        --bone: #e9e4d7;
        --bone-dim: #9a9c8f;
        --line: rgba(233, 228, 215, 0.13);
        --accent: #c8502f;
        --accent-2: #d95c3c;
        --accent-dim: #8a3d2c;
        --disp: 'Fraunces', Georgia, serif;
        --body: 'Spectral', Georgia, serif;
        --mono: 'IBM Plex Mono', ui-monospace, monospace;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body {
        background: var(--ground);
        color: var(--bone);
        font-family: var(--body);
        font-weight: 300;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      img { max-width: 100%; display: block; }
      ::selection { background: var(--accent); color: #fff; }

      .eyebrow {
        font-family: var(--mono);
        font-size: 0.66rem;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: var(--accent);
        font-weight: 500;
      }

      header {
        position: fixed;
        inset: 0 0 auto 0;
        z-index: 40;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.05rem clamp(1rem, 4vw, 2.5rem);
        background: linear-gradient(rgba(11, 13, 12, 0.85), transparent);
      }
      header .wordmark {
        font-family: var(--disp);
        font-weight: 500;
        font-size: 0.98rem;
        color: var(--accent);
        text-decoration: none;
      }
      header .wordmark small {
        display: block;
        font-family: var(--mono);
        font-weight: 400;
        font-size: 0.56rem;
        letter-spacing: 0.22em;
        color: var(--bone-dim);
        margin-top: 0.15rem;
        text-transform: uppercase;
      }
      .hnav { display: flex; align-items: center; gap: clamp(0.9rem, 2vw, 1.7rem); }
      .hnav a {
        font-family: var(--mono);
        font-size: 0.68rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--bone-dim);
        text-decoration: none;
        transition: color 0.3s;
      }
      .hnav a:hover { color: var(--accent); }

      .opening {
        position: relative;
        min-height: 100svh;
        display: flex;
        align-items: center;
        padding: 7rem clamp(1.4rem, 7vw, 7rem) 5rem;
        overflow: hidden;
      }
      .hero-stage { position: absolute; inset: 0; z-index: 0; background: var(--ground); }
      .hero-stage :global(.hero-img) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .opening-veil {
        position: absolute;
        inset: 0;
        z-index: 1;
        background:
          linear-gradient(
            100deg,
            rgba(6, 7, 6, 0.94) 0%,
            rgba(6, 7, 6, 0.82) 30%,
            rgba(6, 7, 6, 0.42) 55%,
            rgba(6, 7, 6, 0.12) 74%,
            transparent 90%
          ),
          linear-gradient(0deg, rgba(5, 6, 5, 0.65) 0%, rgba(5, 6, 5, 0.15) 32%, transparent 58%);
      }
      .opening-inner { position: relative; z-index: 2; max-width: 40rem; }

      .opening h1 {
        font-family: var(--disp);
        font-optical-sizing: auto;
        font-weight: 400;
        font-size: clamp(2.5rem, 7vw, 5.5rem);
        line-height: 1.04;
        letter-spacing: -0.01em;
        text-wrap: balance;
        margin-top: 1.1rem;
      }
      .opening h1 em { font-style: italic; color: var(--accent-2); }
      .opening .lede {
        margin-top: 1.8rem;
        max-width: 44ch;
        font-size: clamp(1rem, 1.6vw, 1.16rem);
        color: var(--bone-dim);
      }

      .projects { list-style: none; margin-top: 3rem; }
      .project { max-width: 46ch; padding-top: 1.6rem; border-top: 1px solid var(--line); }
      .project h2 {
        font-family: var(--disp);
        font-weight: 500;
        font-size: clamp(1.5rem, 3vw, 2.1rem);
        margin: 0.4rem 0 0.3rem;
      }
      .project-blurb { color: var(--bone-dim); font-size: 0.95rem; max-width: 46ch; }
      .enter {
        display: inline-block;
        margin-top: 1.4rem;
        font-family: var(--mono);
        font-size: 0.7rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        background: var(--accent);
        border: 1px solid var(--accent);
        color: #fff;
        padding: 0.8rem 1.2rem;
        text-decoration: none;
        border-radius: 1px;
        transition: background 0.25s, border-color 0.25s;
      }
      .enter:hover { background: var(--accent-dim); border-color: var(--accent-dim); }

      footer {
        position: relative;
        z-index: 2;
        padding: 2.5rem clamp(1.4rem, 7vw, 7rem);
        border-top: 1px solid var(--line);
        font-family: var(--mono);
        font-size: 0.62rem;
        letter-spacing: 0.1em;
        color: var(--bone-dim);
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
      }
      footer a { color: var(--bone-dim); text-decoration: none; }
      footer a:hover { color: var(--accent); }

      @media (max-width: 600px) {
        header { padding: 0.9rem 1rem; }
        .hnav a { font-size: 0.6rem; }
      }
      @media (prefers-reduced-motion: reduce) {
        * { animation: none !important; transition: none !important; }
      }
    </style>
  </body>
</html>
