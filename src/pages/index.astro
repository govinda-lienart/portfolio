---
import heroMp4 from '../assets/hero/hero.mp4?url';
import heroPoster from '../assets/hero/hero-poster.jpg?url';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>Govinda Lienart — Portfolio</title>
    <meta
      name="description"
      content="Portfolio of Govinda Lienart — behavioural ecologist turned machine-learning engineer. Computer vision, PyTorch, MLOps."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;1,9..144,400&family=Spectral:ital,wght@0,300;0,400;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header>
      <a class="wordmark" href={`${base}/`}>
        Govinda&nbsp;Lienart
      </a>
      <nav class="hnav">
        <a href={`${base}/about/`}>About me</a>
        <a href={`${base}/contact/`}>Contact me</a>
      </nav>
    </header>

    <main class="opening">
      <div class="hero-stage" style={`background-image:url(${heroPoster})`}>
        <video
          class="hero-video"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={heroPoster}
        >
          <source src={heroMp4} type="video/mp4" />
        </video>
      </div>
      <div class="opening-veil"></div>

      <div class="opening-inner">
        <p class="eyebrow">Portfolio · {year}</p>

        <svg class="project-logo" viewBox="0 0 190 34" role="img" aria-label="AquaMind">
          <g fill="var(--gold)">
            <path d="M12 17c6-9 20-11 27 0-7 11-21 9-27 0Z" />
            <path d="M12 17 2 10l3.4 7L2 24Z" />
          </g>
          <circle cx="31" cy="14" r="1.7" fill="var(--ground)" />
          <text
            x="52"
            y="24"
            font-family="Fraunces, Georgia, serif"
            font-size="20"
            font-weight="600"
            fill="var(--blue)"
            letter-spacing="0.2">AquaMind</text>
        </svg>

        <h1>Behaviour, <em>measured</em> by machine.</h1>
        <p class="hero-sub">
          Deep-learning eyes on a fish tank — who's who, where they are,
          and what they're doing.
        </p>

        <a class="enter" href={`${base}/aquamind/`}>Enter the project</a>
      </div>
    </main>

    <footer>
      <span>© {year} Govinda Lienart</span>
      <span><a href="https://github.com/govinda-lienart">github.com/govinda-lienart</a></span>
    </footer>

    <style>
      :root {
        --ground: #0b0d0c;
        --ground-2: #12140f;
        --bone: #e9e4d7;
        --bone-dim: #9a9c8f;
        --line: rgba(233, 228, 215, 0.13);
        --blue: #4d86bd;
        --blue-dim: #2a6496;
        --gold: #e6b24c;
        --gold-dim: #b98a34;
        --disp: 'Fraunces', Georgia, serif;
        --body: 'Spectral', Georgia, serif;
        --mono: 'IBM Plex Mono', ui-monospace, monospace;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body {
        background: var(--ground);
        color: var(--bone);
        font-family: var(--body);
        font-weight: 300;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      img { max-width: 100%; display: block; }
      ::selection { background: var(--blue); color: #fff; }

      .eyebrow {
        font-family: var(--mono);
        font-size: 0.74rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: var(--blue);
        font-weight: 700;
        text-shadow: 0 1px 8px rgba(0, 0, 0, 0.85);
      }

      header {
        position: fixed;
        inset: 0 0 auto 0;
        z-index: 40;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.05rem clamp(1rem, 4vw, 2.5rem);
        background: linear-gradient(rgba(11, 13, 12, 0.96), rgba(11, 13, 12, 0.7) 55%, transparent);
      }
      header .wordmark {
        font-family: var(--disp);
        font-weight: 500;
        font-size: 0.98rem;
        color: var(--gold);
        text-decoration: none;
        text-shadow: 0 1px 6px rgba(0, 0, 0, 0.7);
      }
      header .wordmark small {
        display: block;
        font-family: var(--mono);
        font-weight: 500;
        font-size: 0.56rem;
        letter-spacing: 0.22em;
        color: var(--blue);
        margin-top: 0.15rem;
        text-transform: uppercase;
      }
      .hnav { display: flex; align-items: center; gap: clamp(0.6rem, 1.5vw, 1rem); }
      .hnav a {
        font-family: var(--mono);
        font-size: 0.66rem;
        font-weight: 500;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #fff;
        text-decoration: none;
        padding: 0.5rem 0.9rem;
        border: 1px solid var(--gold);
        border-radius: 1px;
        background: var(--blue-dim);
        transition: color 0.25s, background 0.25s;
      }
      .hnav a:hover {
        color: #1a1206;
        background: var(--gold);
      }

      .opening {
        position: relative;
        min-height: 100svh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 7rem clamp(1.4rem, 7vw, 7rem) 5rem;
        overflow: hidden;
      }
      .hero-stage {
        position: absolute;
        inset: 0;
        z-index: 0;
        background-color: var(--ground);
        background-size: cover;
        background-position: center;
      }
      .hero-video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: saturate(1.25) contrast(1.03) brightness(1);
      }
      @media (prefers-reduced-motion: reduce) {
        .hero-video { display: none; }
      }
      .opening-veil {
        position: absolute;
        inset: 0;
        z-index: 1;
        background:
          radial-gradient(
            ellipse 85% 75% at 50% 48%,
            rgba(5, 6, 5, 0.22) 0%,
            rgba(5, 6, 5, 0.38) 60%,
            rgba(4, 5, 4, 0.58) 100%
          ),
          linear-gradient(0deg, rgba(4, 5, 4, 0.5) 0%, rgba(4, 5, 4, 0.12) 45%, rgba(4, 5, 4, 0.22) 100%);
      }
      .opening-veil::after {
        content: '';
        position: absolute;
        inset: 0;
        background:
          linear-gradient(90deg, rgba(4, 5, 4, 0.6) 0%, rgba(4, 5, 4, 0.22) 32%, transparent 52%);
      }
      .opening-inner {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 46rem;
        margin-inline: auto;
      }

      .project-logo {
        display: block;
        width: clamp(180px, 30vw, 240px);
        height: auto;
        margin: 1.2rem 0 1.6rem;
        filter: drop-shadow(0 2px 14px rgba(0, 0, 0, 0.7));
      }

      .opening h1 {
        font-family: var(--disp);
        font-optical-sizing: auto;
        font-weight: 400;
        font-size: clamp(2.5rem, 6.2vw, 5rem);
        line-height: 1.04;
        letter-spacing: -0.01em;
        text-wrap: balance;
        text-shadow: 0 2px 24px rgba(0, 0, 0, 0.75), 0 1px 4px rgba(0, 0, 0, 0.6);
      }
      .opening h1 em {
        font-style: italic;
        color: var(--blue);
        text-shadow: 0 2px 20px rgba(0, 0, 0, 0.85), 0 1px 4px rgba(0, 0, 0, 0.65);
      }
      .hero-sub {
        margin-top: 1.1rem;
        font-size: clamp(0.8rem, 1.4vw, 1.05rem);
        color: #d7d2c4;
        text-shadow: 0 1px 10px rgba(0, 0, 0, 0.85);
      }
      @media (min-width: 48rem) {
        .hero-sub { white-space: nowrap; }
      }
      .enter {
        display: inline-block;
        margin-top: 2.2rem;
        font-family: var(--mono);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        background: var(--gold);
        border: 1px solid var(--gold);
        color: #1a1206;
        padding: 0.85rem 1.3rem;
        text-decoration: none;
        border-radius: 1px;
        transition: background 0.25s, border-color 0.25s, transform 0.25s;
        animation: breathe 3s ease-in-out infinite;
      }
      .enter:hover {
        background: var(--gold-dim);
        border-color: var(--gold-dim);
        animation-play-state: paused;
        transform: translateY(-1px);
      }
      @keyframes breathe {
        0%, 100% {
          transform: scale(1);
          box-shadow: 0 0 0 0 rgba(230, 178, 76, 0);
        }
        50% {
          transform: scale(1.045);
          box-shadow: 0 0 26px 5px rgba(230, 178, 76, 0.55);
        }
      }

      footer {
        position: relative;
        z-index: 2;
        padding: 2.5rem clamp(1.4rem, 7vw, 7rem);
        border-top: 1px solid var(--line);
        font-family: var(--mono);
        font-size: 0.62rem;
        letter-spacing: 0.1em;
        color: var(--bone-dim);
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
      }
      footer a { color: var(--bone-dim); text-decoration: none; }
      footer a:hover { color: var(--blue); }

      @media (max-width: 600px) {
        header { padding: 0.9rem 1rem; }
        .hnav a { font-size: 0.6rem; }
      }
      @media (prefers-reduced-motion: reduce) {
        * { animation: none !important; transition: none !important; }
      }
    </style>
  </body>
</html>
